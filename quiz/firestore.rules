rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // ADMIN USERS
    // -------------------------
    match /admins/{userId} {

      // A logged-in user can read only their own admin record
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // Only an existing admin can create/update/delete admin records
      allow write: if request.auth != null
                    && exists(
                      /databases/$(database)/documents/admins/$(request.auth.uid)
                    )
                    && request.auth.uid == userId;
    }


    // -------------------------
    // SUBJECTS
    // -------------------------
    match /subjects/{subjectId} {

      // Students can see subjects
      allow read: if true;

      // Only admins can modify subjects
      allow write: if isAdmin();
    }


    // -------------------------
    // QUIZZES
    // -------------------------
    match /quizzes/{quizId} {

      // Students can read published quizzes
      allow read: if resource.data.status == "published"
                  || isAdmin();

      // Admins can create/edit/delete quizzes
      allow write: if isAdmin();


      // -------------------------
      // QUESTIONS
      // -------------------------
      match /questions/{questionId} {

        // Students can read questions belonging to published quizzes
        allow read: if get(
          /databases/$(database)/documents/quizzes/$(quizId)
        ).data.status == "published"
        || isAdmin();

        // Only admins can modify questions
        allow write: if isAdmin();
      }
    }


    // -------------------------
    // QUIZ ATTEMPTS
    // -------------------------
    match /attempts/{attemptId} {

      // Students can submit an attempt
      allow create: if true;

      // Students should not modify an existing attempt
      allow update, delete: if isAdmin();

      // Admins can view attempts
      allow read: if isAdmin();
    }


    // -------------------------
    // LEADERBOARD
    // -------------------------
    match /leaderboards/{subjectId} {

      allow read: if true;

      allow write: if isAdmin();

      match /students/{studentId} {

        allow read: if true;

        allow write: if isAdmin();
      }
    }


    // -------------------------
    // ADMIN CHECK
    // -------------------------
    function isAdmin() {
      return request.auth != null
             && exists(
               /databases/$(database)/documents/admins/$(request.auth.uid)
             )
             && get(
               /databases/$(database)/documents/admins/$(request.auth.uid)
             ).data.active == true;
    }
  }
}
